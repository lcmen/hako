#!/usr/bin/env bash

# shellcheck disable=SC1091,SC2155
set -euo pipefail

# Resolve script path when invoked through symlink
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(CDPATH='' cd -- "$(dirname -- "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"

  if [[ "$link_target" == /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done

readonly LIB_DIR="$(CDPATH='' cd -- "$(dirname -- "$script_path")" && pwd)"
readonly INSTALL_DIR="$(CDPATH='' cd -- "$LIB_DIR/.." && pwd)"

source "$LIB_DIR/log.sh"

if [[ ! -f "$INSTALL_DIR/manifest" ]]; then
  log_error "Hako manifest not found: $INSTALL_DIR/manifest"
  exit 1
fi

source "$INSTALL_DIR/manifest"
source "$LIB_DIR/context.sh"

case "${ADAPTER:-}" in
  apple)
    source "$LIB_DIR/apple.sh"
    ;;
  docker)
    source "$LIB_DIR/docker.sh"
    ;;
  *)
    log_error "Hako manifest has an unsupported adapter: ${ADAPTER:-missing}"
    log_error "Force-reinstall this tool to create a valid manifest"
    exit 1
    ;;
esac

readonly CONTAINER="$(container_name)"
readonly NETWORK="hako"

ensure_data_dir() {
  local data
  data="$(data_dir)"
  log_debug "Ensuring Redis data directory exists: $data"
  mkdir -p "$data"
  chmod 0777 "$data"
}

create_server_container() {
  log_debug "Creating Redis container $CONTAINER from $IMAGE"
  ensure_image "$IMAGE"
  ensure_network "$NETWORK"
  ensure_data_dir

  container_create "redis-cli ping" \
    --name "$CONTAINER" \
    --network "$NETWORK" \
    --user redis \
    --volume "$(data_dir):/data" \
    "$IMAGE" redis-server \
    --appendonly yes \
    --appendfsync everysec >/dev/null
}

run_client() {
  require_adapter
  ensure_image "$IMAGE"
  log_debug "Running Redis client from $IMAGE"

  case "${1:-}" in
    --help|--version|-v)
      container_run --rm "$IMAGE" redis-cli "$@"
      return
      ;;
  esac

  ensure_network "$NETWORK"
  container_run --rm "$(container_tty_args)" \
    --network "$NETWORK" \
    "$IMAGE" redis-cli -h "$(container_host "$CONTAINER")" "$@"
}

start_server() {
  require_adapter

  if ! container_exists "$CONTAINER"; then
    log_debug "Redis container does not exist: $CONTAINER"
    create_server_container
  else
    log_debug "Redis container already exists: $CONTAINER"
  fi

  if ! container_running "$CONTAINER"; then
    log_debug "Starting Redis container: $CONTAINER"
    container_start "$CONTAINER" >/dev/null
  else
    log_debug "Redis container is already running: $CONTAINER"
  fi

  container_ready "$CONTAINER" 60 redis-cli ping
  log_status "Redis $VERSION is running as $CONTAINER on $ADAPTER network $NETWORK"
}

status_server() {
  require_adapter
  container_status "$CONTAINER" "Redis" redis-cli ping
}

stop_server() {
  require_adapter

  if ! container_exists "$CONTAINER"; then
    log_status "Redis $VERSION is not running as $CONTAINER on $ADAPTER network $NETWORK"
    return 3
  fi

  if container_running "$CONTAINER"; then
    container_stop "$CONTAINER" >/dev/null
  fi

  container_delete "$CONTAINER" >/dev/null
  log_status "Redis $VERSION stopped and removed container $CONTAINER"
}

redis_server_wrapper() {
  if (( $# == 0 )); then
    start_server
    container_logs "$CONTAINER"
    return
  fi

  local action="$1"
  shift

  case "$action" in
    start)
      start_server
      ;;
    stop)
      stop_server "$@"
      ;;
    status)
      status_server
      ;;
    restart)
      stop_server "$@" || true
      start_server
      ;;
    *)
      log_error "Hako redis-server supports start, stop, status, and restart"
      log_error "Unsupported redis-server action: $action"
      exit 2
      ;;
  esac
}

command_name="$(basename "$0")"

case "$command_name" in
  redis-cli)
    run_client "$@"
    ;;
  redis-server)
    redis_server_wrapper "$@"
    ;;
  *)
    log_error "Unsupported hako Redis command: $command_name"
    exit 2
    ;;
esac
