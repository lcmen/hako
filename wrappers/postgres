#!/usr/bin/env bash

# shellcheck disable=SC1091,SC2155
set -euo pipefail

# Resolve script path when invoked through symlink
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(CDPATH='' cd -- "$(dirname -- "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"

  if [[ "$link_target" == /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done

readonly LIB_DIR="$(CDPATH='' cd -- "$(dirname -- "$script_path")" && pwd)"
readonly INSTALL_DIR="$(CDPATH='' cd -- "$LIB_DIR/.." && pwd)"

source "$LIB_DIR/log.sh"

if [[ ! -f "$INSTALL_DIR/manifest" ]]; then
  log_error "Hako manifest not found: $INSTALL_DIR/manifest"
  exit 1
fi

source "$INSTALL_DIR/manifest"
source "$LIB_DIR/context.sh"

if [[ -z "${PGUSER:-}" ]]; then
  log_error "PGUSER is required"
  exit 1
fi
if [[ -z "${PGPASS:-}" ]]; then
  log_error "PGPASS is required"
  exit 1
fi

case "${ADAPTER:-}" in
  apple)
    source "$LIB_DIR/apple.sh"
    ;;
  docker)
    source "$LIB_DIR/docker.sh"
    ;;
  *)
    log_error "Hako manifest has an unsupported adapter: ${ADAPTER:-missing}"
    log_error "Force-reinstall this tool to create a valid manifest"
    exit 1
    ;;
esac

readonly CONTAINER="$(container_name)"
readonly NETWORK="hako"

ensure_data_dir() {
  local data
  data="$(data_dir)"
  log_debug "Ensuring PostgreSQL data directory exists: $data"
  mkdir -p "$data"
}

create_server_container() {
  log_debug "Creating PostgreSQL container $CONTAINER from $IMAGE"
  ensure_image "$IMAGE"
  ensure_network "$NETWORK"
  ensure_data_dir

  container_create "pg_isready -U $PGUSER" \
    --name "$CONTAINER" \
    --network "$NETWORK" \
    --volume "$(data_dir):/var/lib/postgresql/data" \
    --env POSTGRES_DB="$PGUSER" \
    --env POSTGRES_USER="$PGUSER" \
    --env POSTGRES_PASSWORD="$PGPASS" \
    --env PGDATA=/var/lib/postgresql/data/pgdata \
    "$IMAGE" >/dev/null
}

start_server() {
  require_adapter

  if ! container_exists "$CONTAINER"; then
    log_debug "PostgreSQL container does not exist: $CONTAINER"
    create_server_container
  else
    log_debug "PostgreSQL container already exists: $CONTAINER"
  fi

  if ! container_running "$CONTAINER"; then
    log_debug "Starting PostgreSQL container: $CONTAINER"
    container_start "$CONTAINER" >/dev/null
  else
    log_debug "PostgreSQL container is already running: $CONTAINER"
  fi

  container_ready "$CONTAINER" 60 pg_isready -U "$PGUSER"
  log_status "PostgreSQL $VERSION is running as $CONTAINER on $ADAPTER network $NETWORK"
}

stop_server() {
  require_adapter

  if ! container_exists "$CONTAINER"; then
    log_status "PostgreSQL $VERSION is not running as $CONTAINER on $ADAPTER network $NETWORK"
    return 3
  fi

  if container_running "$CONTAINER"; then
    container_stop "$CONTAINER" >/dev/null
  fi

  container_delete "$CONTAINER" >/dev/null
  log_status "PostgreSQL $VERSION stopped and removed container $CONTAINER"
}

status_server() {
  require_adapter
  container_status "$CONTAINER" "PostgreSQL" pg_isready -U "$PGUSER"
}

reload_server() {
  require_adapter

  if ! container_running "$CONTAINER"; then
    log_error "PostgreSQL container is not running: $CONTAINER"
    return 3
  fi

  log_debug "Reloading PostgreSQL configuration in $CONTAINER"
  container_exec "$CONTAINER" pg_ctl reload -D "${PGDATA:-/var/lib/postgresql/data/pgdata}"
}

run_client() {
  local client="$1"
  shift

  require_adapter
  ensure_image "$IMAGE"
  ensure_network "$NETWORK"
  log_debug "Running PostgreSQL client $client from $IMAGE"

  case "${1:-}" in
    --help|--version|-V)
      container_run --rm "$IMAGE" "$client" "$@"
      return
      ;;
  esac

  container_run --rm "$(container_tty_args)" \
    --network "$NETWORK" \
    --volume "$PWD:$PWD" \
    --workdir "$PWD" \
    --env PGPASSWORD="$PGPASS" \
    "$IMAGE" "$client" -h "$(container_host "$CONTAINER")" -U "$PGUSER" "$@"
}

pg_ctl_wrapper() {
  local action="${1:-status}"
  shift || true

  case "$action" in
    start)
      start_server
      ;;
    stop)
      stop_server "$@"
      ;;
    status)
      status_server
      ;;
    restart)
      stop_server "$@" || true
      start_server
      ;;
    reload)
      reload_server
      ;;
    *)
      log_error "Hako pg_ctl supports start, stop, status, restart, and reload"
      log_error "Unsupported pg_ctl action: $action"
      exit 2
      ;;
  esac
}

command_name="$(basename "$0")"

case "$command_name" in
  pg_ctl)
    pg_ctl_wrapper "$@"
    ;;
  postgres)
    pg_ctl_wrapper start
    container_logs "$CONTAINER"
    ;;
  psql|pg_dump|pg_restore|createdb|dropdb|createuser|dropuser)
    run_client "$command_name" "$@"
    ;;
  *)
    log_error "Unsupported hako PostgreSQL command: $command_name"
    exit 2
    ;;
esac
